{
  "name": "@ship/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "ShipShape submission dashboard - static + hybrid live data",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run snapshot && tsc -b && vite build",
    "build:no-snapshot": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "snapshot": "tsx ../scripts/dashboard/snapshot.ts",
    "type-check": "tsc -b",
    "clean": "rm -rf dist .vite tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.6"
  }
}
